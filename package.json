{
  "name": "ompdk",
  "version": "1.1.0",
  "type": "module",
  "description": "ompDK — 本機 omp (oh-my-pi) 的網頁／桌機介面：左側 session 紀錄，右側聊天框",
  "author": "e78-png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/e78-png/ompdk.git"
  },
  "homepage": "https://github.com/e78-png/ompdk",
  "scripts": {
    "dev": "vite",
    "build": "bun run gen:zh-hant && vite build",
    "start": "bun run server/main.ts",
    "gen:zh-hant": "bun scripts/gen-zh-hant.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "lint:omp": "bun run scripts/lint-omp.ts",
    "omp:check": "bun run scripts/omp-check.ts",
    "omp:record": "bun run scripts/omp-record.ts",
    "omp:wire-diff": "bun run scripts/omp-wire-diff.ts",
    "test": "bun test",
    "electron:dev": "bun scripts/build-electron.ts --dev",
    "electron:build": "bun scripts/build-electron.ts"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "highlight.js": "^11.11.1",
    "katex": "^0.19.0",
    "marked": "^15.0.12",
    "qrcode-generator": "2.0.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^26.6.4",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "@types/dompurify": "^3.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "opencc-js": "^1.4.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
